@model List<ToDoItem>
@{
    ViewData["Title"] = "Görevlerim";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h2>Görevlerim</h2>

        @* Yeni görev ekleme formu *@
        <form asp-action="Add" method="post" class="input-group mb-4">
            <input type="text" name="title" class="form-control" placeholder="Yeni görev..." required />
            <button type="submit" class="btn btn-success">Ekle</button>
        </form>

        @* Görev listesi *@
        @if (Model.Any())
        {
            <ul class="list-group">
                @foreach (var item in Model)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            @if (item.IsCompleted)
                            {
                                <del>@item.Title</del>
                            }
                            else
                            {
                                @item.Title
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <small class="text-muted ms-2">(@item.User?.UserName)</small>
                            }
                        </div>
                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                        </form>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">Henüz hiç görev eklenmedi.</p>
        }
    </div>
</div>